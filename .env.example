# GullyQuiz Environment Configuration

# Application
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection URL (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gullyquiz?schema=public"

# Payment Service Configuration
# PAYMENT_MOCK_MODE: Set to true for instant simulated ₹10 UPI payment authorizations (default for local dev)
PAYMENT_MOCK_MODE=true
PAYMENT_PROVIDER=MOCK

# Live Gateway Configuration (optional, ready-to-wire)
# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Quiz Mechanics Configuration
# Currency unit: paise (1000 paise = ₹10.00)
ENTRY_FEE_PAISE=1000
QUESTION_TIME_LIMIT_SECONDS=10
QUESTIONS_PER_MATCH=5
MIN_PLAYERS_PER_MATCH=2
MAX_PLAYERS_PER_MATCH=8

# Revenue Splits (%)
WINNER_PRIZE_PERCENTAGE=70
VENDOR_COMMISSION_PERCENTAGE=20
PLATFORM_SHARE_PERCENTAGE=10
